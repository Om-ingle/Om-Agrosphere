# ─────────────────────────────────────────────────────────────────────────────
# Om Agrosphere — environment configuration
# Copy to `.env.local` for development. Set the same keys in your hosting
# provider's dashboard for production. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public site origin, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://omagrosphere.com

# ── Contact details ─────────────────────────────────────────────────────────
# Phone number, WhatsApp number, opening hours and the business address are
# confirmed facts and live in `src/content/site.ts`, not here — so the site
# shows them immediately on deploy with no configuration. Edit them there.

# ── Map ─────────────────────────────────────────────────────────────────────
# Nothing to configure. The Contact page embeds the business's own Google Maps
# listing — an exact pin, with coordinates in structured data. Both live in
# `src/content/site.ts` → `location`.

# ── Inquiry email delivery (server-side only) ───────────────────────────────
# Inquiries are emailed via Resend (https://resend.com) — HTTP API, no extra
# dependency. Without RESEND_API_KEY the form tells the visitor it could not be
# submitted and offers WhatsApp / phone / email instead, so no lead is lost.
RESEND_API_KEY=
# Must be an address on a domain you have verified with Resend.
INQUIRY_FROM_EMAIL=Om Agrosphere Website <website@omagrosphere.com>
INQUIRY_TO_EMAIL=omagrosphere@gmail.com

# ── Spam protection (optional) ──────────────────────────────────────────────
# Google reCAPTCHA v3. A honeypot field and submit-timing check are always on;
# these keys add reCAPTCHA on top. Both must be set for it to take effect.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Analytics / Search Console (optional) ───────────────────────────────────
# Google Analytics 4 measurement ID. Analytics loads only when this is set.
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification token (the `content` value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
